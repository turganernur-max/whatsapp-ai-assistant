# Скопируйте значения в настройки сервера (Render → Environment). НЕ коммитьте реальные ключи в GitHub.

# --- Панель управления ---
ADMIN_PASSWORD=придумайте-длинный-пароль
SESSION_SECRET=случайная-строка-минимум-32-символа
# PUBLIC_URL=https://your-app.onrender.com   (на Render определяется автоматически)
NODE_ENV=production

# --- База данных (Neon Postgres). Если пусто — встроенная база в папке DATA_DIR ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
META_APP_SECRET=
# Подключение своего номера WhatsApp Business (coexistence) через окно Meta:
META_APP_ID=
META_ES_CONFIG_ID=
WEBHOOK_VERIFY_TOKEN=случайная-строка
# GRAPH_API_VERSION=v23.0

# --- Claude API ---
ANTHROPIC_API_KEY=

# --- Необязательно: распознавание голосовых (Groq, OpenAI или другой совместимый сервис) ---
STT_API_KEY=
# STT_BASE_URL=https://api.groq.com/openai/v1
# STT_MODEL=whisper-large-v3

# --- Необязательно: push-уведомления на iPhone через приложение ntfy ---
NTFY_TOPIC=
